# SatQuery AI — copy to .env for local docker compose.
# Never commit real credentials. Air-gapped hosts keep this file internal.

SATQUERY_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Bind-mounted offline weights (host ./local_models -> /local_models and /app/models)
LOCAL_MODELS_DIR=/local_models
DATA_DIR=/app/data

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Force Hugging Face / Transformers to stay offline after weights are staged.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Optional GPU selection on the host.
# CUDA_VISIBLE_DEVICES=0

POSTGRES_USER=satquery_admin
POSTGRES_PASSWORD=isro_secure_db
POSTGRES_DB=satquery_gis
POSTGRES_PORT=5432
DATABASE_URL=postgresql://satquery_admin:isro_secure_db@db:5432/satquery_gis

# Host-side Ollama (reachable from backend via host.docker.internal)
OLLAMA_HOST=http://host.docker.internal:11434
