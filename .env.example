# SatQuery AI — copy to .env for local docker compose.
# Never commit real credentials. Air-gapped hosts should keep this file internal.

SATQUERY_ENV=development
POSTGRES_USER=satquery
POSTGRES_PASSWORD=satquery
POSTGRES_DB=satquery
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000
OLLAMA_PORT=11434
VLLM_PORT=8001

INFERENCE_BACKEND=ollama
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
